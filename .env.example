NODE_ENV=production
PORT=8090
ADMIN_EMAIL=geral@uneed.pt
ADMIN_PASSWORD=trocar-por-password-forte
DATABASE_URL=postgresql://user:password@host:5432/railway
RESEND_API_KEY=re_xxxxxxxxx
EMAIL_FROM=UNEED <geral@uneed.pt>
GOOGLE_PLACES_API_KEY=AIza...
OPENAI_API_KEY=
OPENAI_PROSPECT_API_KEY=sk-...
OPENAI_IMAGE_API_KEY=sk-...
OPENAI_PROSPECT_MODEL=gpt-4o-mini
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_IMAGE_QUALITY=medium
OPENAI_IMAGE_SIZE=1536x1024
OPENAI_MOCKUP_HOURLY_LIMIT=20

# Vercel + Supabase
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=ey...
# Optional. AI calls stay server-side; model routing is centralized.
OPENAI_API_KEY=
UNEED_AI_SMART_MODEL=gpt-5-mini
UNEED_AI_MAX_CALL_COST=0.25
# Leave blank to report actual cost as unknown; set both from the provider's current pricing.
UNEED_AI_INPUT_COST_PER_MILLION=
UNEED_AI_OUTPUT_COST_PER_MILLION=
UNEED_AI_FAST_ROUTE=local-evidence,openai
UNEED_AI_SMART_ROUTE=openai,local-evidence
UNEED_AI_DEEP_ROUTE=openai,local-evidence

# Runtime assíncrono. Em produção usar API e worker Railway separados.
MISSION_RUNNER_EMBEDDED=false
MISSION_WORKER_CONCURRENCY=1
MISSION_POLL_MS=1500
MISSION_STALE_MS=120000
MISSION_MAX_STEPS=10
MISSION_TIMEOUT_MS=300000
MISSION_CREATE_RATE_LIMIT=5

# Deploy frontend Vercel → API Railway
SUPABASE_URL=
SUPABASE_ANON_KEY=
FRONTEND_ORIGIN=https://crm.uneed.pt
VITE_UNEED_OS_API_URL=

# DISCOVER. OpenAI Web Search is active and reuses OPENAI_API_KEY.
OPENAI_WEB_SEARCH_MODEL=gpt-5-mini
# Leave blank to persist actual search cost as unknown; the maximum still protects the budget.
OPENAI_WEB_SEARCH_COST_PER_QUERY=
OPENAI_WEB_SEARCH_MAX_QUERY_COST=0.05
# Alternative adapter retained in code (inactive).
BRAVE_SEARCH_API_KEY=
BRAVE_SEARCH_COST_PER_QUERY=
BRAVE_SEARCH_MAX_QUERY_COST=0.05
MAX_WEB_SEARCHES=2
MAX_PAGES_FETCHED=3
MAX_WEBSITE_DEPTH=1
MAX_HIGH_TICKET_SEARCHES=3
MAX_HIGH_TICKET_PAGES=6
MAX_HIGH_TICKET_DEPTH=1
MAX_HIGH_TICKET_COST=0.50
DISCOVER_SEARCH_TIMEOUT_MS=45000
DISCOVER_FETCH_TIMEOUT_MS=8000
DISCOVER_MAX_PAGE_BYTES=750000
DISCOVER_MAX_REDIRECTS=3
DISCOVER_CACHE_TTL_MS=900000
